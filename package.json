        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "jsdom": "^29.1.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "typescript": "^7.0.2",
        "vitest": "^5.0.3"
    }
}
