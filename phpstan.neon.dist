includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - src
        - routes
        # Add database (migrations) when the package has some. config/ is left
        # out: Larastan reads it as app code and flags its env() calls.
    tmpDir: build/phpstan
    treatPhpDocTypesAsCertain: false
